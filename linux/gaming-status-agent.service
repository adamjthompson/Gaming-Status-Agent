# systemd user service for running Gaming Status Agent without a tray icon.
#   cp linux/gaming-status-agent.service ~/.config/systemd/user/
#   (edit ExecStart to point at your copy of gsa_linux.py)
#   systemctl --user daemon-reload
#   systemctl --user enable --now gaming-status-agent
#   journalctl --user -u gaming-status-agent -f

[Unit]
Description=Gaming Status Agent
After=network-online.target graphical-session.target

[Service]
ExecStart=/usr/bin/python3 %h/gaming-status-agent/linux/gsa_linux.py --headless
Restart=on-failure
RestartSec=10
# Defence in depth that doesn't affect detection. Don't add ProtectProc=,
# ProtectHome=, ProtectSystem=strict, PrivateNetwork= or PrivateTmp=: the
# agent reads other processes' /proc entries, its ~/.config and the Steam
# and Heroic folders, talks to MQTT and the emulators' sockets in
# $XDG_RUNTIME_DIR, and some user managers can't create the namespaces
# PrivateTmp needs.
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=default.target
