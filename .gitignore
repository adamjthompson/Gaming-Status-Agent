# Files Gaming Status Agent writes next to itself at runtime. These contain personal data -
# your broker address, MQTT username, encrypted password, profile names and a
# history of what you have played - and must never be committed.
gsa_config.json
gsa_config.json.tmp
gsa_debug.log
gsa_debug.log.*
gsa_diagnostics.txt
gsa_ubi_ids.json
"Gaming Status Agent.spec"
GamingStatusAgent.spec

# Local backups / scratch copies 
*_backup.py
*.bak
*.orig

# PyInstaller
build/
dist/
*.spec
*.manifest

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Release builds are attached to GitHub Releases by .github/workflows/release.yml,
# never committed: each 19 MB copy would stay in git history for good.
*.exe
version_info.txt
